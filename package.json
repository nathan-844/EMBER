{
  "name": "ember",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EMBER - fire safety research explorer for NASA PSI microgravity combustion evidence, with grounded AI synthesis",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-api.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:ai": "tsx scripts/benchmark-ai.ts",
    "verify:report": "node scripts/verify-report.mjs",
    "sync:psi": "node --use-env-proxy scripts/sync-psi.mjs",
    "sync:tables": "node scripts/sync-tables.mjs && node scripts/index-tables.mjs",
    "data:normalize": "node scripts/normalize-conditions.mjs && node scripts/index-tables.mjs && npm run data:atlas",
    "data:atlas": "tsx scripts/build-atlas.ts && npm run data:findings",
    "data:findings": "tsx scripts/build-findings.ts && tsx scripts/build-counts.ts",
    "data:all": "node scripts/normalize-conditions.mjs && node scripts/index-tables.mjs && npm run data:atlas && npm run build:api && npm run verify:report",
    "data:check": "node scripts/check-data.mjs",
    "record:demo": "tsx scripts/record-demo.ts",
    "video:record": "node scripts/record-video.mjs",
    "preview:demo": "vite preview --mode demo --port 4173 --strictPort",
    "build:api": "node scripts/build-api.mjs",
    "recheck:recorded": "tsx scripts/recheck-recorded.ts",
    "sync:ntrs": "tsx scripts/sync-ntrs.ts",
    "sync:same": "python3 scripts/sync-same-results.py"
  },
  "dependencies": {
    "@vercel/functions": "^3.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
