# Copy to .env.local and add your key. Never commit .env.local.
# Enables the optional "Analyze scenario" panel (Google Gemini, called server-side only).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: comma-separated models in fallback order (429/5xx/404 move to the next one).
# GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.8-flash
# Gemini 2.5 models are closed to keys created after late 2026.
# Optional: Gemini 3 thinking level for live answers: low (default, ~10-20 s) | medium | high | default (model's own, ~1-2 min).
# GEMINI_THINKING=low
